# iOS simulator: localhost. Real iPhone: use your computer's LAN IP.
# Staging/production must use an HTTPS API URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Phase 2 Supabase Auth: URL and publishable key are public configuration.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a secret/service-role key here.

# Public, published HTTPS legal pages. Supply final operator-approved URLs.
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_TERMS_URL=

# Explicit design preview ONLY. Keep unset for the real authenticated API.
# EXPO_PUBLIC_DISCOVER_PREVIEW=1

# EAS native device builds require public HTTPS configuration.
# APP_VARIANT=preview
# Prefer linking these public identities in app.json; env overrides must match.
# EAS_PROJECT_ID=
# IOS_BUNDLE_IDENTIFIER=
# EXPO_ACCOUNT_OWNER=
# Expo access tokens belong in secure runtime settings, not this client file.
