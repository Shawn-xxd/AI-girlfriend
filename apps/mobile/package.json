{
  "name": "@companion/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --ios --go",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "eas-build-post-install": "pnpm --filter @companion/shared build && node config/check-build.cjs",
    "check:device-config": "node config/check-build.cjs",
    "build:preview": "APP_VARIANT=preview node config/check-build.cjs && pnpm dlx eas-cli@27.7.2 build --platform ios --profile preview",
    "update:preview": "pnpm --filter @companion/shared build && APP_VARIANT=preview pnpm dlx eas-cli@27.7.2 update --platform ios --channel preview --environment preview",
    "start:dev-client": "expo start --dev-client"
  },
  "dependencies": {
    "@companion/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-image": "58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "unicode-segmenter": "0.17.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
