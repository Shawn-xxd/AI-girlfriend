NODE_ENV=development
PORT=3000
# Optional browser preview origins, comma-separated; native iOS does not need CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SUPABASE_URL=https://dxpiqttvtxjhmlvxstbb.supabase.co
# Server-only Secret key. Configure securely; never EXPO_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Current generation provider. Never paste real keys into Git/chat.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=
AI_MAX_OUTPUT_TOKENS=512
AI_CONTEXT_TURNS=10

# Independent content gate. DeepSeek JSON classifier is the default.
MODERATION_PROVIDER=deepseek
MODERATION_MODEL=deepseek-chat

# Optional future OpenAI Responses configuration (not required for DeepSeek).
# AI_PROVIDER_API_KEY=
# Optional dedicated OpenAI moderation (not required for DeepSeek).
# MODERATION_API_KEY=
# Other OpenAI-compatible HTTPS providers use their own key and URL.
# AI_COMPATIBLE_API_KEY=
# AI_BASE_URL=https://your-provider.example/v1
